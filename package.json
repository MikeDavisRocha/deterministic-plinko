{
  "name": "deterministic-plinko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden": "esbuild src/test/print-golden.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/golden.mjs --log-level=warning && node node_modules/.tmp/golden.mjs",
    "measure": "esbuild src/test/measure.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/measure.mjs --log-level=warning && node node_modules/.tmp/measure.mjs",
    "symmetry": "esbuild src/test/print-symmetry.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/symmetry.mjs --log-level=warning && node node_modules/.tmp/symmetry.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
